  "components": {
    "schemas": {
      "BrokerTradeRequest": {
        "properties": {
          "price": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Price",
            "description": "Optional override price. If omitted, service fetches Binance quote."
          }
        },
        "type": "object",
        "title": "BrokerTradeRequest"
      },
      "DecisionResponse": {
        "properties": {
          "action": {
            "type": "string",
            "title": "Action"
          },
          "reason": {
            "type": "string",
            "title": "Reason"
          },
          "price": {
            "type": "number",
            "title": "Price"
          },
          "notional_usd": {
            "type": "number",
            "title": "Notional Usd"
          },
          "tranche_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tranche Id"
          },
          "grid_index": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Grid Index"
          },
          "expected_profit_usd": {
            "type": "number",
            "title": "Expected Profit Usd"
          },
          "expected_profit_bps": {
            "type": "number",
            "title": "Expected Profit Bps"
          },
          "expected_gross_profit_bps": {
            "type": "number",
            "title": "Expected Gross Profit Bps"
          },
          "executed": {
            "type": "boolean",
            "title": "Executed"
          }
        },
        "type": "object",
        "required": [
          "action",
          "reason",
          "price",
          "notional_usd",
          "tranche_id",
          "grid_index",
          "expected_profit_usd",
          "expected_profit_bps",
          "expected_gross_profit_bps",
          "executed"
        ],
        "title": "DecisionResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "StateResponse": {
        "properties": {
          "usd_available": {
            "type": "number",
            "title": "Usd Available"
          },
          "usdt_available": {
            "type": "number",
            "title": "Usdt Available"
          },
          "realized_profit_usd": {
            "type": "number",
            "title": "Realized Profit Usd"
          },
          "open_tranches": {
            "items": {
              "$ref": "#/components/schemas/TrancheResponse"
            },
            "type": "array",
            "title": "Open Tranches"
          }
        },
        "type": "object",
        "required": [
          "usd_available",
          "usdt_available",
          "realized_profit_usd",
          "open_tranches"
        ],
        "title": "StateResponse"
      },
      "StrategyConfigPayload": {
        "properties": {
          "total_capital_usd": {
            "type": "number",
            "minimum": 500.0,
            "maximum": 200000.0,
            "title": "Total Capital Usd",
            "default": 30000.0
          },
          "tranche_count": {
            "type": "integer",
            "maximum": 20.0,
            "minimum": 1.0,
            "title": "Tranche Count",
            "default": 3
          },
          "strategy_mode": {
            "type": "string",
            "enum": [
              "static",
              "gradient"
            ],
            "title": "Strategy Mode",
            "default": "gradient"
          },
          "reference_price": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Reference Price",
            "default": 1.0
          },
          "buy_threshold_bps": {
            "type": "number",
            "minimum": 0.0,
            "title": "Buy Threshold Bps",
            "default": 5.0
          },
          "min_profit_bps": {
            "type": "number",
            "minimum": 0.0,
            "title": "Min Profit Bps",
            "default": 5.0
          },
          "fee_bps": {
            "type": "number",
            "minimum": 0.0,
            "title": "Fee Bps",
            "default": 1.0
          },
          "slippage_bps": {
            "type": "number",
            "minimum": 0.0,
            "title": "Slippage Bps",
            "default": 1.0
          },
          "min_notional_usd": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Min Notional Usd",
            "default": 10.0
          },
          "max_open_tranches": {
            "type": "integer",
            "maximum": 20.0,
            "minimum": 1.0,
            "title": "Max Open Tranches",
            "default": 3
          },
          "max_buy_price": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Max Buy Price",
            "default": 0.9994
          },
          "min_sell_price": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Min Sell Price",
            "default": 1.0
          },
          "grid_step": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Grid Step",
            "default": 0.0005
          },
          "min_buy_price": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Min Buy Price",
            "default": 0.99
          },
          "max_usdt_allocation_pct": {
            "type": "number",
            "maximum": 1.0,
            "exclusiveMinimum": 0.0,
            "title": "Max Usdt Allocation Pct",
            "default": 1.0
          }
        },
        "type": "object",
        "title": "StrategyConfigPayload"
      },
      "TickRequest": {
        "properties": {
          "price": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Price",
            "description": "Current USDT/USD price"
          },
          "execute": {
            "type": "boolean",
            "title": "Execute",
            "description": "Apply the decision to the paper portfolio",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "price"
        ],
        "title": "TickRequest"
      },
      "TrancheResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "entry_price": {
            "type": "number",
            "title": "Entry Price"
          },
          "notional_usd": {
            "type": "number",
            "title": "Notional Usd"
          },
          "usdt_amount": {
            "type": "number",
            "title": "Usdt Amount"
          },
          "opened_at": {
            "type": "string",
            "title": "Opened At"
          },
          "grid_index": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Grid Index"
          }
        },
        "type": "object",
        "required": [
          "id",
          "entry_price",
          "notional_usd",
          "usdt_amount",
          "opened_at",
          "grid_index"
        ],
        "title": "TrancheResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
